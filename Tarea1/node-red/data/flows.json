        "name": "function 2",
        "func": "let f = msg.fecha;\nlet p = msg.payload;\n\nlet diasSemana = [\"domingo\", \"lunes\", \"martes\", \"miércoles\", \"jueves\", \"viernes\", \"sábado\"];\n\nmsg.payload = {\n    fecha: f.toLocaleDateString(\"es-ES\"),\n    hora: f.toLocaleTimeString(\"es-ES\"),\n    diaSemana: diasSemana[f.getDay()],\n    mensaje: \"Hoy es \" + diasSemana[f.getDay()] + \" \" + p.dia + \"/\" + p.mes + \"/\" + p.anio +\n             \" y son las \" + f.toLocaleTimeString(\"es-ES\"),\n    iso: p.iso\n};\nreturn msg;",
