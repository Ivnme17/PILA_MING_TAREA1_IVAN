    {
        "id": "e1ca70460c7c3ea5",
        "type": "function",
        "z": "586c162d642e7bbd",
        "name": "function 9",
        "func": "const pedido = msg.payload;\n\n// Validación básica\nif (typeof pedido !== \"object\" || pedido === null) {\n    node.warn(\"Se esperaba un objeto JSON. Recibido: \" + JSON.stringify(pedido));\n    return null;\n}\n\nconst importe = Number(pedido.importe);\nif (isNaN(importe)) {\n    node.warn(\"El importe no es numérico en el pedido \" + pedido.idPedido);\n    return null;\n}\n\nconst salida1 = [];  // Express (+ avisos a financiero)\nconst salida2 = [];  // Estándar\nconst salida3 = [];  // Internacional\n\n// Reglas 1-3: enrutado principal\nif (pedido.pais !== \"ES\") {\n    salida3.push(msg);\n} else if (pedido.vip === true || importe >= 100) {\n    salida1.push(msg);\n} else {\n    salida2.push(msg);\n}\n\n// Regla 4 (extra): copia de aviso a financiero por la Salida 1\nif (importe > 500) {\n    const aviso = RED.util.cloneMessage(msg);\n    aviso.topic = \"aviso_financiero\";\n    aviso.payload = {\n        aviso: \"Pedido de importe elevado (> 500 €)\",\n        idPedido: pedido.idPedido,\n        importe: importe,\n        pais: pedido.pais\n    };\n    salida1.push(aviso);\n}\n\nreturn [salida1, salida2, salida3];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
