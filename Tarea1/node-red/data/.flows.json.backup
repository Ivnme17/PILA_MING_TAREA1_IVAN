        "z": "f31e1480f8d41f11",
        "name": "function 6",
        "func": "if (msg.topic === \"reset\") {\n    context.set(\"min\", null);\n    context.set(\"max\", null);\n    context.set(\"suma\", 0);\n    context.set(\"contador\", 0);\n\n    node.status({ fill: \"yellow\", shape: \"ring\", text: \"Estadísticas reiniciadas\" });\n    msg.payload = \"Estadísticas reiniciadas a cero\";\n    return msg;\n}\n\nconst valor = Number(msg.payload);\nif (msg.payload === \"\" || msg.payload === null || isNaN(valor)) {\n    node.warn(\"Payload no numérico ignorado: \" + msg.payload);\n    node.status({ fill: \"red\", shape: \"ring\", text: \"Valor no válido\" });\n    return null;\n}\n\nlet min = context.get(\"min\");\nlet max = context.get(\"max\");\nlet suma = context.get(\"suma\") || 0;\nlet contador = context.get(\"contador\") || 0;\n\nif (min === null || valor < min) min = valor;\nif (max === null || valor > max) max = valor;\nsuma += valor;\ncontador++;\n\ncontext.set(\"min\", min);\ncontext.set(\"max\", max);\ncontext.set(\"suma\", suma);\ncontext.set(\"contador\", contador);\n\nconst media = suma / contador;\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: \"Media: \" + media.toFixed(2) + \" | Lecturas: \" + contador\n});\n\nmsg.payload = {\n    valor: valor,\n    min: min,\n    max: max,\n    media: Number(media.toFixed(2)),\n    contador: contador\n};\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\ncontext.set(\"min\", null);\ncontext.set(\"max\", null);\ncontext.set(\"suma\", 0);\ncontext.set(\"contador\", 0);",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 280,
