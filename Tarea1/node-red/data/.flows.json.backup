    {
        "id": "690b1f3e15bbba8f",
        "type": "function",
        "z": "abdd2a876d4941c6",
        "name": "function 4",
        "func": "let contador = context.get(\"contador\") || 0;\ncontador = contador +1;\n\nlet lista = context.get(\"historico\") || [];\nlista.push({\n    orden: contador,\n    valor: msg.payload,\n    hora: new Date().toLocaleTimeString()\n});\n\ncontext.set(\"contador\", contador);\ncontext.set(\"historico\", lista);\n\n\nmsg.payload = {\n    mensajeActual: msg.payload,\n    ejecuciones: contador,\n    ultimos: lista.slice(-3)\n};\n\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\n// flow -> variable global\n// contexto -> variable publica\nflow.set(\"contador\",0);\ncontext.set(\"historico\",[])",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 400,
        "wires": [
            [
                "dd86686f42629457"
            ]
        ]
    },
