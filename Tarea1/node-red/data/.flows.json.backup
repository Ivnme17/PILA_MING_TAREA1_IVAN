    {
        "id": "7c98fd4215cfc839",
        "type": "function",
        "z": "abdd2a876d4941c6",
        "name": "function 3",
        "func": "let lectura = Number(msg.payload)\nlet aula = msg.topic || \"Desconocida\"\n\nmsg.payload = {\n    ubicacion: aula,\n    medidas: {\n        celsius: lectura,\n        fahrenheit: Number((((lectura * 9)/5)+32).toFixed(2)),\n        kelvin: Number((lectura + 273.15).toFixed(2))\n    },\n    metadatos: {\n        timestamp: new Date().toISOString(),\n        origen: \"Node-RED\",\n        valido: !isNaN(lectura)\n    }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 260,
        "wires": [
            [
                "3481f1c91b07df22",
                "f62260acc52efabf"
            ]
        ]
    },
