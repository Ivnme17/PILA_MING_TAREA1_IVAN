        "z": "75f80b78b395aca7",
        "name": "function 7",
        "func": "const valor = msg.payload\nif(isNaN(valor)){\n    node.warn(\"El umbral debe ser un número. Recibido: \" + msg.payload);\n    return null;\n}\nflow.set(\"umbral_alerta\", valor)\nmsg.payload = \"Umbral configurado a \" + valor + \" °C\";\nreturn msg;",
        "outputs": 1,
