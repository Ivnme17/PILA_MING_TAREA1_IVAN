    {
        "id": "3179cd25c4e96fa2",
        "type": "function",
        "z": "d87740e33f59232a",
        "name": "function 10",
        "func": "const lote = msg.payload;\n\nif (!Array.isArray(lote)) {\n    node.warn(\"Se esperaba un array de sensores. Recibido: \" + JSON.stringify(lote));\n    return null;\n}\n\nconst mensajes = [];\n\nfor (const sensor of lote) {\n    if (sensor.val === -999) {\n        // Fallo de lectura: aviso amarillo y sin mensaje\n        node.warn(\"Fallo de lectura en el sensor \" + sensor.id);\n        continue;\n    }\n\n    // Sensor válido: un mensaje independiente\n    const nuevo = RED.util.cloneMessage(msg);\n    nuevo.payload = sensor;\n    nuevo.topic = sensor.id;\n    mensajes.push(nuevo);\n}\n\nreturn [mensajes];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
