    {
        "id": "221cb54a1d3266e2",
        "type": "inject",
        "z": "abdd2a876d4941c6",
        "name": "marca tiempo",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 140,
        "wires": [
            [
                "9ce89f48f0fa23f6"
            ]
        ]
    },
    {
        "id": "9ce89f48f0fa23f6",
        "type": "function",
        "z": "abdd2a876d4941c6",
        "name": "function 1",
        "func": "let fecha = new Date(msg.payload);\n\nmsg.fecha = fecha;\nmsg.payload = {\n    timestamp: msg.payload,\n    iso: fecha.toISOString(),\n    dia: fecha.getDate(),\n    mes: fecha.getMonth() + 1,\n    anio: fecha.getFullYear(),\n    hora: fecha.getHours(),\n    minutos: fecha.getMinutes(),\n    segundos: fecha.getSeconds()\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 140,
        "wires": [
            [
                "9660561a1f972000"
            ]
        ]
    },
    {
        "id": "9660561a1f972000",
        "type": "function",
        "z": "abdd2a876d4941c6",
        "name": "function 2",
        "func": "let f = msg.fecha;\nlet p = msg.payload;\n\nlet diasSemana = [\"domingo\", \"lunes\", \"martes\", \"miércoles\", \"jueves\", \"viernes\", \"sábado\"];\n\nmsg.payload = {\n    fecha: f.toLocaleDateString(\"es-ES\"),\n    hora: f.toLocaleTimeString(\"es-ES\"),\n    diaSemana: diasSemana[f.getDay()],\n    mensaje: \"Hoy es \" + diasSemana[f.getDay()] + \" \" + p.dia + \"/\" + p.mes + \"/\" + p.anio +\n             \" y son las \" + f.toLocaleTimeString(\"es-ES\"),\n    iso: p.iso\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 140,
        "wires": [
            [
                "e76b93987448837d"
            ]
        ]
    },
    {
        "id": "2a57d929164dcb05",
        "type": "mqtt in",
        "z": "abdd2a876d4941c6",
