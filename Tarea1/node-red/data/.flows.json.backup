    {
        "id": "199ae681025e7c8d",
        "type": "function",
        "z": "75f80b78b395aca7",
        "name": "function 8",
        "func": "let temperatura = Number(msg.payload)\nif(isNaN(temperatura)){\n    node.warn(\"La temperatura debe ser un número. Recibido: \" + msg.payload);\n    return null;\n}\n\nconst umbral = flow.get(\"umbral_alerta\") || 30;\n// En el caso de que la entrada numerica sea 0\n//if (umbral === undefined) umbral = 30;\nif (temperatura > umbral) {\n    msg.payload = \"ALERTA: \" + temperatura + \" °C supera el umbral de \" + umbral + \" °C\";\n} else {\n    msg.payload = \"OK: \" + temperatura + \" °C no supera el umbral de \" + umbral + \" °C\";\n}\n\nreturn msg;",
