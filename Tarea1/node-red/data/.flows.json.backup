    {
        "id": "c632d12d796387e9",
        "type": "function",
        "z": "c21a542bb5f0e525",
        "name": "limpiar cadena",
        "func": "let nombreLimpio = msg.payload.trim();\n\nlet partes = nombreLimpio.split(/\\s+/);\nnode.warn(\"nombreLimpio: \" + nombreLimpio);\nfunction sinTildes(texto) {\n    return texto.normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\");\n}\n\n// cogemos la inicial de la lista de cadenas\nlet inicial = partes[0].charAt(0);\n// Aqui obtenemos el apellido\nlet primerApellido = partes[1];\n//juntamos las dos para obtener el nombre con apellido y todo en minuscula\nlet username = sinTildes(inicial + primerApellido).toLowerCase();\n\n// Montar objeto JSON\nmsg.payload = {\n    nombreLimpio: nombreLimpio,\n    username: username,\n    partes: partes,\n    numPalabras: partes.length,\n    activo: true\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 360,
        "wires": [
            [
                "96a3f4adef5d2b3b"
            ]
        ]
    },
