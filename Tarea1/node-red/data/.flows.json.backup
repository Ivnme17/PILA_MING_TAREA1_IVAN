        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "[{\"id\": \"S1\", \"val\": 22}, {\"id\": \"S2\", \"val\": -999}, {\"id\": \"S3\", \"val\": 25}, {\"id\": \"S4\", \"val\": 19}]",
        "payloadType": "json",
        "x": 290,
        "y": 240,
        "wires": [
            [
                "5346d78533eb966c",
                "3179cd25c4e96fa2"
