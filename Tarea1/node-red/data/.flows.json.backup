    {
        "id": "e28b6a0a07e0fb4b",
        "type": "function",
        "z": "1519417fdbd5a1d3",
        "name": "function 5",
        "func": "let producto = msg.payload\nlet subtotal = 0\nlet importeIVA = 0\nlet total = 0\nif (producto[\"unidades\"] > 0){\n    // subtotal es cantidad por precio\n    subtotal = producto[\"unidades\"] * producto[\"precio\"]\n    importeIVA = producto[\"precio\"] * (producto[\"iva\"]/100)\n    // suma de subtotal e importe con IVA\n    total = subtotal + importeIVA\n\n}else{\n    return; // salir silenciosamente \n}\n// Montar objeto JSON\nmsg.payload = {\n    subtotal: subtotal.toFixed(2),\n    importeIVA: importeIVA.toFixed(2),\n    total: total.toFixed(2),\n};\nmsg.topic = \"factura emitida\"\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 240,
        "wires": [
            [
                "dcd734b926cf3078"
            ]
        ]
    },
