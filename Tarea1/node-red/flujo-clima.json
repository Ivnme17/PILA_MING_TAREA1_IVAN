  {
    "id": "clima_fn",
    "type": "function",
    "z": "clima_tab",
    "name": "3 puntos almeria_clima",
    "func": "const d = msg.payload;\n\n// Los tres valores que llegan del script\nconst medidas = [\n    { symbol: \"Tª\", valor: d.temperatura },\n    { symbol: \"H\",  valor: d.humedad },\n    { symbol: \"P\",  valor: d.presion }\n];\n\n// Si falta algún dato o no es un número: se avisa en el log y se descarta\nfor (const m of medidas) {\n    if (typeof m.valor !== \"number\" || isNaN(m.valor)) {\n        node.warn(\"Dato no válido para \" + m.symbol + \": \" + JSON.stringify(d));\n        node.status({ fill: \"red\", shape: \"ring\", text: \"dato inválido \" + m.symbol });\n        return null;\n    }\n}\n\n// Un punto de InfluxDB por cada symbol\nmsg.payload = medidas.map(m => ({\n    measurement: \"almeria_clima\",\n    tags: { symbol: m.symbol, source: \"open-meteo\" },\n    fields: { valor: m.valor, ts_api: d.ts_api }\n}));\nnode.status({ fill: \"green\", shape: \"dot\", text: d.temperatura + \" °C\" });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 220,
    "wires": [
      [
        "clima_dbg",
        "clima_out"
      ]
    ]
